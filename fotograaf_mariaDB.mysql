-- ============================================
-- TABEL: Betaling
-- Elke betaling verwijst naar een Factuur
-- ============================================
CREATE TABLE Betaling (
    BetalingID INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    factuur_id INT,
    datum      DATE,
    bedrag     DECIMAL(10,2),
    methode    VARCHAR(50),
    CONSTRAINT fk_betaling_factuur FOREIGN KEY (factuur_id) REFERENCES Factuur(FactuurID)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

