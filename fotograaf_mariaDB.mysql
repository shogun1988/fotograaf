-- ============================================
-- TABEL: Factuur
-- ============================================
CREATE TABLE Factuur (
    FactuurID    INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    klant_id     INT,
    fotoshoot_id INT,
    datum        DATE,
    totaalbedrag DECIMAL(10,2),
    status       VARCHAR(50),
    CONSTRAINT fk_factuur_klant FOREIGN KEY (klant_id) REFERENCES Klant(KlantID),
    CONSTRAINT fk_factuur_fotoshoot FOREIGN KEY (fotoshoot_id) REFERENCES Fotoshoot(FotoshootID)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

