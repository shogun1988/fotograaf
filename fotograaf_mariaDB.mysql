-- ============================================
-- TABEL: Fotoshoot
-- ============================================
CREATE TABLE Fotoshoot (
    FotoshootID INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    klant_id    INT,
    pakket_id   INT,
    locatie_id  INT,
    datum       DATE,
    starttijd   TIME,
    eindtijd    TIME,
    status      VARCHAR(50),
    opmerkingen TEXT,
    CONSTRAINT fk_fotoshoot_klant FOREIGN KEY (klant_id) REFERENCES Klant(KlantID),
    CONSTRAINT fk_fotoshoot_pakket FOREIGN KEY (pakket_id) REFERENCES Pakket(PakketID),
    CONSTRAINT fk_fotoshoot_locatie FOREIGN KEY (locatie_id) REFERENCES Locatie(LocatieID)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

