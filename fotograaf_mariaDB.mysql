-- ============================================
-- DATABASE STRUCTUUR VOOR FOTOGRAAF-SYSTEEM
-- MariaDB-versie
-- ============================================

-- Verwijder bestaande tabellen in juiste volgorde (rekening houden met FK-afhankelijkheden)
DROP TABLE IF EXISTS Levering;
DROP TABLE IF EXISTS Foto;
DROP TABLE IF EXISTS Betaling;
DROP TABLE IF EXISTS Factuur;
DROP TABLE IF EXISTS Fotoshoot;
DROP TABLE IF EXISTS Locatie;
DROP TABLE IF EXISTS Pakket;
DROP TABLE IF EXISTS Klant;
DROP TABLE IF EXISTS Address;

-- ============================================
-- TABEL: Address
-- Bevat gestructureerde adresgegevens voor zowel Klant als Locatie
-- ============================================
CREATE TABLE Address (
    AddressID  INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    straat     VARCHAR(100) NOT NULL,
    huisnummer VARCHAR(10)  NOT NULL,
    busnummer  VARCHAR(10),
    postcode   VARCHAR(10)  NOT NULL,
    stad       VARCHAR(100) NOT NULL,
    land       VARCHAR(50)  NOT NULL DEFAULT 'Belgie'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

