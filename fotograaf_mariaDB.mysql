-- ============================================
-- TABEL: Pakket
-- ============================================
CREATE TABLE Pakket (
    PakketID                INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    naam                    VARCHAR(50)   NOT NULL,
    beschrijving            TEXT,
    prijs                   DECIMAL(10,2) NOT NULL,
    aantal_fotos_inbegrepen INT,
    levertijd_dagen         INT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

