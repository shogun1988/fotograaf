-- ============================================
-- TABEL: Klant
-- adres_id verwijst naar Address(AddressID)
-- ============================================
CREATE TABLE Klant (
    KlantID    INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    voornaam   VARCHAR(50)  NOT NULL,
    achternaam VARCHAR(50)  NOT NULL,
    email      VARCHAR(100) NOT NULL UNIQUE,
    telefoon   VARCHAR(20),
    adres_id   INT,
    type_klant VARCHAR(50),
    CONSTRAINT fk_klant_address FOREIGN KEY (adres_id) REFERENCES Address(AddressID)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

