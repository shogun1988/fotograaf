-- ============================================
-- TABEL: Locatie
-- adres_id verwijst naar Address(AddressID)
-- ============================================
CREATE TABLE Locatie (
    LocatieID INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    naam      VARCHAR(100) NOT NULL,
    adres_id  INT,
    type      VARCHAR(50),
    CONSTRAINT fk_locatie_address FOREIGN KEY (adres_id) REFERENCES Address(AddressID)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

