-- ============================================
-- TABEL: Levering
-- ============================================
CREATE TABLE Levering (
    LeveringID    INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    fotoshoot_id  INT,
    leverdatum    DATE,
    type          VARCHAR(50),
    download_link VARCHAR(200),
    aantal_prints INT,
    CONSTRAINT fk_levering_fotoshoot FOREIGN KEY (fotoshoot_id) REFERENCES Fotoshoot(FotoshootID)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

