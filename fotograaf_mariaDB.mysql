-- ============================================
-- TABEL: Foto
-- Fotoshoot_id verwijst naar Fotoshoot(FotoshootID)
-- ============================================
CREATE TABLE Foto (
    FotoID          INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    Fotoshoot_id    INT,
    bestandsnaam    VARCHAR(200),
    resolutie       VARCHAR(50),
    formaat         VARCHAR(20),
    is_geselecteerd BOOLEAN,
    is_bewerkt      BOOLEAN,
    CONSTRAINT fk_foto_fotoshoot FOREIGN KEY (Fotoshoot_id) REFERENCES Fotoshoot(FotoshootID)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

