<%- include('../partials/head', { title: title }) %>
<div class="app-shell flex min-h-screen bg-soft">
  <%- include('../partials/sidebar', { currentPath: currentPath }) %>

  <div class="min-w-0 flex-1">
    <header class="border-b border-line bg-white/80 px-6 py-5 backdrop-blur lg:px-8">
      <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
        <div>
          <p class="eyebrow mb-2">Shootplanning</p>
          <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink"><%= pageTitle %></h1>
          <p class="muted mt-2 text-sm"><%= pageSubtitle %></p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <form action="/fotoshoots" method="GET" class="surface-card flex items-center gap-3 px-4 py-3" data-realtime-search="fotoshoots">
            <label for="fotoshoots-search" class="sr-only">Fotoshoots zoeken</label>
            <input id="fotoshoots-search" name="q" value="<%= search %>" type="search"
              placeholder="Zoek klant, pakket of locatie..." class="form-control min-w-0 sm:w-64 !py-2" />
            <label for="status" class="text-sm font-semibold text-ink">Status</label>
            <select id="status" name="status" class="form-select min-w-[180px] !py-2">
              <option value="">Alle statussen</option>
              <option value="gepland" <%= selectedStatus === 'gepland' ? 'selected' : '' %>>Gepland</option>
              <option value="afgewerkt" <%= selectedStatus === 'afgewerkt' ? 'selected' : '' %>>Afgewerkt</option>
              <option value="geannuleerd" <%= selectedStatus === 'geannuleerd' ? 'selected' : '' %>>Geannuleerd</option>
            </select>
            <button type="submit" class="btn btn-secondary !py-2">Filter</button>
          </form>

          <a href="/fotoshoots/new" class="btn btn-primary">
            <i data-lucide="plus" class="h-4 w-4"></i>
            Nieuwe fotoshoot
          </a>
        </div>
      </div>
    </header>

    <main class="px-6 py-6 lg:px-8">
      <%- include('../partials/flash', { feedback: feedback }) %>

      <section class="surface-card p-0" data-search-results="fotoshoots">
        <% if (fotoshoots.length === 0) { %>
          <div class="empty-state">
            <p class="mb-4 text-lg font-semibold text-ink">Geen fotoshoots gevonden voor deze zoekopdracht of filter.</p>
            <a href="/fotoshoots/new" class="btn btn-primary">Nieuwe fotoshoot plannen</a>
          </div>
        <% } else { %>
          <div class="table-shell">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Datum</th>
                  <th>Klant</th>
                  <th>Pakket</th>
                  <th>Locatie</th>
                  <th>Status</th>
                  <th>Acties</th>
                </tr>
              </thead>
              <tbody>
                <% fotoshoots.forEach((fotoshoot) => { %>
                  <tr data-search-item="fotoshoots">
                    <td>
                      <div class="font-semibold"><%= formatDate(fotoshoot.datum) %></div>
                      <div class="muted text-sm"><%= formatTime(fotoshoot.starttijd) %> - <%= formatTime(fotoshoot.eindtijd) %></div>
                    </td>
                    <td><%= fotoshoot.klant_naam || '—' %></td>
                    <td><%= fotoshoot.pakket_naam || '—' %></td>
                    <td><%= fotoshoot.locatie_naam || '—' %></td>
                    <td><span class="<%= badgeClass(fotoshoot.status) %>"><%= fotoshoot.status %></span></td>
                    <td>
                      <div class="flex flex-wrap gap-2">
                        <a href="/fotoshoots/<%= fotoshoot.fotoshootid %>" class="btn action-btn action-view">Bekijk</a>
                        <a href="/fotoshoots/<%= fotoshoot.fotoshootid %>/edit" class="btn action-btn action-edit">Bewerk</a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
