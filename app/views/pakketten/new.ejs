<%- include('../partials/head', { title: title }) %>
<div class="app-shell flex min-h-screen bg-soft">
  <%- include('../partials/sidebar', { currentPath: currentPath }) %>
  <div class="min-w-0 flex-1">
    <header class="border-b border-line bg-white/80 px-6 py-5 backdrop-blur lg:px-8">
      <p class="eyebrow mb-2">Aanbod</p>
      <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink"><%= pageTitle %></h1>
      <p class="muted mt-2 text-sm"><%= pageSubtitle %></p>
    </header>
    <main class="px-6 py-6 lg:px-8">
      <%- include('../partials/flash', { feedback: feedback }) %>
      <section class="surface-card p-6">
        <form action="/pakketten" method="POST" class="space-y-6">
          <div class="grid gap-4 md:grid-cols-2">
            <label class="block md:col-span-2">
              <span class="mb-2 block text-sm font-semibold text-ink">Naam</span>
              <input type="text" name="naam" required class="form-control" value="<%= pakket.naam %>" placeholder="bijv. Wedding Premium" />
            </label>
            <label class="block md:col-span-2">
              <span class="mb-2 block text-sm font-semibold text-ink">Beschrijving</span>
              <textarea name="beschrijving" rows="3" class="form-control"><%= pakket.beschrijving %></textarea>
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-semibold text-ink">Prijs (€)</span>
              <input type="number" name="prijs" required step="0.01" min="0" class="form-control" value="<%= pakket.prijs %>" />
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-semibold text-ink">Foto's inbegrepen</span>
              <input type="number" name="aantal_fotos_inbegrepen" min="0" class="form-control" value="<%= pakket.aantal_fotos_inbegrepen %>" />
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-semibold text-ink">Levertijd (dagen)</span>
              <input type="number" name="levertijd_dagen" min="0" class="form-control" value="<%= pakket.levertijd_dagen %>" />
            </label>
          </div>
          <div class="flex flex-wrap gap-3">
            <button type="submit" class="btn btn-primary">Pakket opslaan</button>
            <a href="/pakketten" class="btn btn-secondary">Annuleren</a>
          </div>
        </form>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
