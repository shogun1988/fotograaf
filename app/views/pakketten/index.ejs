<%- include('../partials/head', { title: title }) %>
<div class="app-shell flex min-h-screen bg-soft">
  <%- include('../partials/sidebar', { currentPath: currentPath }) %>

  <div class="min-w-0 flex-1">
    <header class="border-b border-line bg-white/80 px-6 py-5 backdrop-blur lg:px-8">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="eyebrow mb-2">Aanbod</p>
          <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink"><%= pageTitle %></h1>
          <p class="muted mt-2 text-sm"><%= pageSubtitle %></p>
        </div>
        <a href="/pakketten/new" class="btn btn-primary">
          <i data-lucide="plus" class="h-4 w-4"></i>
          Nieuw pakket
        </a>
      </div>
    </header>

    <main class="px-6 py-6 lg:px-8">
      <section class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <% pakketten.forEach((pakket) => { %>
          <article class="surface-card p-6">
            <div class="mb-5 flex items-start justify-between gap-4">
              <div>
                <p class="eyebrow mb-2">Pakket</p>
                <h2 class="text-xl font-bold tracking-[-0.03em]"><%= pakket.naam %></h2>
              </div>
              <span class="rounded-full bg-accent-soft px-3 py-1 text-sm font-bold text-accent"><%= formatCurrency(pakket.prijs) %></span>
            </div>

            <p class="muted leading-7"><%= pakket.beschrijving || 'Geen beschrijving beschikbaar.' %></p>

            <div class="mt-6 grid gap-3">
              <div class="info-item">
                <p class="eyebrow mb-2">Foto's inbegrepen</p>
                <p class="font-semibold"><%= pakket.aantal_fotos_inbegrepen || 0 %> foto's</p>
              </div>
              <div class="info-item">
                <p class="eyebrow mb-2">Levertijd</p>
                <p class="font-semibold"><%= pakket.levertijd_dagen || '—' %> dagen</p>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
              <a href="/pakketten/<%= pakket.pakketid %>" class="btn btn-secondary">Bekijk</a>
              <a href="/pakketten/<%= pakket.pakketid %>/edit" class="btn btn-secondary">Bewerk</a>
              <form action="/pakketten/<%= pakket.pakketid %>" method="POST" onsubmit="return confirm('Weet je zeker dat je dit pakket wilt verwijderen?');">
                <input type="hidden" name="_method" value="DELETE" />
                <button type="submit" class="btn btn-danger">Verwijder</button>
              </form>
            </div>
          </article>
        <% }) %>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
