<%- include('../partials/head', { title: title }) %>
<div class="app-shell flex min-h-screen bg-soft">
  <%- include('../partials/sidebar', { currentPath: currentPath }) %>
  <div class="min-w-0 flex-1">
    <header class="border-b border-line bg-white/80 px-6 py-5 backdrop-blur lg:px-8">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="eyebrow mb-2">Pakketdetail</p>
          <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink"><%= pageTitle %></h1>
          <p class="muted mt-2 text-sm"><%= pageSubtitle %></p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/pakketten/<%= pakket.pakketid %>/edit" class="btn action-btn action-edit">
            <i data-lucide="pencil" class="h-4 w-4"></i> Bewerk
          </a>
          <form action="/pakketten/<%= pakket.pakketid %>" method="POST" onsubmit="return confirm('Pakket verwijderen?');">
            <input type="hidden" name="_method" value="DELETE" />
            <button type="submit" class="btn action-btn action-delete">
              <i data-lucide="trash-2" class="h-4 w-4"></i> Verwijder
            </button>
          </form>
        </div>
      </div>
    </header>

    <main class="space-y-6 px-6 py-6 lg:px-8">
      <%- include('../partials/flash', { feedback: feedback }) %>

      <div class="grid gap-6 md:grid-cols-2">
        <section class="surface-card p-6">
          <h2 class="mb-5 text-lg font-bold tracking-[-0.02em]">Pakketdetails</h2>
          <dl class="space-y-4">
            <div class="info-item">
              <dt class="eyebrow mb-1">Naam</dt>
              <dd class="text-xl font-bold text-ink"><%= pakket.naam %></dd>
            </div>
            <div class="info-item">
              <dt class="eyebrow mb-1">Prijs</dt>
              <dd class="text-2xl font-bold text-accent"><%= formatCurrency(pakket.prijs) %></dd>
            </div>
            <div class="info-item">
              <dt class="eyebrow mb-1">Beschrijving</dt>
              <dd class="muted leading-7"><%= pakket.beschrijving || '—' %></dd>
            </div>
            <div class="info-item">
              <dt class="eyebrow mb-1">Foto's inbegrepen</dt>
              <dd class="font-semibold"><%= pakket.aantal_fotos_inbegrepen || 0 %> foto's</dd>
            </div>
            <div class="info-item">
              <dt class="eyebrow mb-1">Levertijd</dt>
              <dd class="font-semibold"><%= pakket.levertijd_dagen || '—' %> dagen</dd>
            </div>
          </dl>
        </section>

        <section class="surface-card p-6">
          <h2 class="mb-5 text-lg font-bold tracking-[-0.02em]">Shoots met dit pakket</h2>
          <% if (shoots.length === 0) { %>
            <p class="muted text-sm">Nog geen shoots met dit pakket.</p>
          <% } else { %>
            <div class="space-y-3">
              <% shoots.forEach(s => { %>
                <a href="/fotoshoots/<%= s.fotoshootid %>" class="flex items-center justify-between rounded-xl border border-line bg-soft px-4 py-3 hover:bg-white transition-colors">
                  <div>
                    <p class="font-semibold text-ink"><%= s.klant_naam %></p>
                    <p class="muted text-xs"><%= formatDate(s.datum) %></p>
                  </div>
                  <span class="<%= badgeClass(s.status) %>"><%= s.status %></span>
                </a>
              <% }) %>
            </div>
          <% } %>
        </section>
      </div>

      <div class="flex gap-3">
        <a href="/pakketten" class="btn btn-secondary">
          <i data-lucide="arrow-left" class="h-4 w-4"></i> Terug naar pakketten
        </a>
      </div>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
