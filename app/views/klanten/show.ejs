<%- include('../partials/head', { title: title }) %>
<div class="app-shell flex min-h-screen bg-soft">
  <%- include('../partials/sidebar', { currentPath: currentPath }) %>

  <div class="min-w-0 flex-1">
    <header class="border-b border-line bg-white/80 px-6 py-5 backdrop-blur lg:px-8">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="eyebrow mb-2">Klantdetail</p>
          <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink"><%= pageTitle %></h1>
          <p class="muted mt-2 text-sm"><%= pageSubtitle %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/klanten" class="btn action-btn action-view">Terug</a>
          <a href="/klanten/<%= klant.klantid %>/edit" class="btn action-btn action-edit">Klant bewerken</a>
        </div>
      </div>
    </header>

    <main class="space-y-6 px-6 py-6 lg:px-8">
      <%- include('../partials/flash', { feedback: feedback }) %>

      <section class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_380px]">
        <article class="surface-card p-6">
          <div class="mb-6 flex items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-bold tracking-[-0.03em]">Contactgegevens</h2>
              <p class="muted mt-1 text-sm">Alle primaire klantinformatie op één plaats.</p>
            </div>
            <span class="badge status-default"><%= klant.type_klant || '—' %></span>
          </div>

          <div class="info-grid">
            <div class="info-item">
              <p class="eyebrow mb-2">Voornaam</p>
              <p class="font-semibold"><%= klant.voornaam %></p>
            </div>
            <div class="info-item">
              <p class="eyebrow mb-2">Achternaam</p>
              <p class="font-semibold"><%= klant.achternaam %></p>
            </div>
            <div class="info-item">
              <p class="eyebrow mb-2">E-mail</p>
              <p class="font-semibold"><%= klant.email %></p>
            </div>
            <div class="info-item">
              <p class="eyebrow mb-2">Telefoon</p>
              <p class="font-semibold"><%= klant.telefoon || '—' %></p>
            </div>
          </div>
        </article>

        <article class="surface-card p-6">
          <h2 class="text-xl font-bold tracking-[-0.03em]">Adres</h2>
          <p class="muted mt-1 text-sm">Volledig adres voor administratie en facturatie.</p>

          <div class="mt-6 space-y-4">
            <div class="info-item">
              <p class="eyebrow mb-2">Straat</p>
              <p class="font-semibold"><%= klant.straat || '—' %></p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="info-item">
                <p class="eyebrow mb-2">Huisnummer</p>
                <p class="font-semibold"><%= klant.huisnummer || '—' %></p>
              </div>
              <div class="info-item">
                <p class="eyebrow mb-2">Busnummer</p>
                <p class="font-semibold"><%= klant.busnummer || '—' %></p>
              </div>
              <div class="info-item">
                <p class="eyebrow mb-2">Postcode</p>
                <p class="font-semibold"><%= klant.postcode || '—' %></p>
              </div>
              <div class="info-item">
                <p class="eyebrow mb-2">Stad</p>
                <p class="font-semibold"><%= klant.stad || '—' %></p>
              </div>
            </div>
            <div class="info-item">
              <p class="eyebrow mb-2">Land</p>
              <p class="font-semibold"><%= klant.land || 'Belgie' %></p>
            </div>
          </div>
        </article>
      </section>

      <section class="surface-card p-0">
        <div class="border-b border-line px-5 py-4">
          <h2 class="text-xl font-bold tracking-[-0.03em]">Fotoshoots van deze klant</h2>
          <p class="muted mt-1 text-sm">Overzicht van alle geplande en afgewerkte shoots voor deze klant.</p>
        </div>

        <% if (fotoshoots.length === 0) { %>
          <div class="empty-state">Nog geen fotoshoots gekoppeld aan deze klant.</div>
        <% } else { %>
          <div class="table-shell">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Datum</th>
                  <th>Tijd</th>
                  <th>Pakket</th>
                  <th>Locatie</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% fotoshoots.forEach((shoot) => { %>
                  <tr>
                    <td class="font-semibold"><%= formatDate(shoot.datum) %></td>
                    <td><%= formatTime(shoot.starttijd) %> - <%= formatTime(shoot.eindtijd) %></td>
                    <td><%= shoot.pakket_naam || '—' %></td>
                    <td><%= shoot.locatie_naam || '—' %></td>
                    <td><span class="<%= badgeClass(shoot.status) %>"><%= shoot.status %></span></td>
                    <td><a href="/fotoshoots/<%= shoot.fotoshootid %>" class="btn btn-secondary">Bekijk shoot</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
