<%- include('../partials/head', { title: title }) %>
<div class="app-shell flex min-h-screen bg-soft">
  <%- include('../partials/sidebar', { currentPath: currentPath }) %>

  <div class="min-w-0 flex-1">
    <header class="border-b border-line bg-white/80 px-6 py-5 backdrop-blur lg:px-8">
      <p class="eyebrow mb-2">Nieuwe klant</p>
      <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink"><%= pageTitle %></h1>
      <p class="muted mt-2 text-sm"><%= pageSubtitle %></p>
    </header>

    <main class="px-6 py-6 lg:px-8">
      <section class="surface-card p-6">
        <form action="/klanten" method="POST" class="space-y-8">
          <div>
            <h2 class="text-xl font-bold tracking-[-0.03em]">Klantgegevens</h2>
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Voornaam</span>
                <input type="text" name="voornaam" required class="form-control" value="<%= klant.voornaam %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Achternaam</span>
                <input type="text" name="achternaam" required class="form-control" value="<%= klant.achternaam %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">E-mail</span>
                <input type="email" name="email" required class="form-control" value="<%= klant.email %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Telefoon</span>
                <input type="text" name="telefoon" class="form-control" value="<%= klant.telefoon %>" />
              </label>
              <label class="block md:col-span-2">
                <span class="mb-2 block text-sm font-semibold text-ink">Type klant</span>
                <select name="type_klant" class="form-select">
                  <option value="particulier" <%= klant.type_klant === 'particulier' ? 'selected' : '' %>>Particulier</option>
                  <option value="bedrijf" <%= klant.type_klant === 'bedrijf' ? 'selected' : '' %>>Bedrijf</option>
                </select>
              </label>
            </div>
          </div>

          <div>
            <h2 class="text-xl font-bold tracking-[-0.03em]">Adres</h2>
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              <label class="block md:col-span-2">
                <span class="mb-2 block text-sm font-semibold text-ink">Straat</span>
                <input type="text" name="straat" required class="form-control" value="<%= klant.straat %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Huisnummer</span>
                <input type="text" name="huisnummer" required class="form-control" value="<%= klant.huisnummer %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Busnummer</span>
                <input type="text" name="busnummer" class="form-control" value="<%= klant.busnummer %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Postcode</span>
                <input type="text" name="postcode" required class="form-control" value="<%= klant.postcode %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Stad</span>
                <input type="text" name="stad" required class="form-control" value="<%= klant.stad %>" />
              </label>
              <label class="block md:col-span-2">
                <span class="mb-2 block text-sm font-semibold text-ink">Land</span>
                <input type="text" name="land" class="form-control" value="<%= klant.land %>" />
              </label>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <button type="submit" class="btn btn-primary">Klant opslaan</button>
            <a href="/klanten" class="btn btn-secondary">Annuleren</a>
          </div>
        </form>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
