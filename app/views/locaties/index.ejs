<%- include('../partials/head', { title: title }) %>
<div class="app-shell flex min-h-screen bg-soft">
  <%- include('../partials/sidebar', { currentPath: currentPath }) %>

  <div class="min-w-0 flex-1">
    <header class="border-b border-line bg-white/80 px-6 py-5 backdrop-blur lg:px-8">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="eyebrow mb-2">Locatieoverzicht</p>
          <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink"><%= pageTitle %></h1>
          <p class="muted mt-2 text-sm"><%= pageSubtitle %></p>
        </div>
        <a href="/locaties/new" class="btn btn-primary">
          <i data-lucide="plus" class="h-4 w-4"></i>
          Nieuwe locatie
        </a>
      </div>
    </header>

    <main class="px-6 py-6 lg:px-8">
      <section class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <% locaties.forEach((locatie) => { %>
          <article class="surface-card p-6">
            <div class="mb-5 flex items-start justify-between gap-4">
              <div>
                <p class="eyebrow mb-2">Locatie</p>
                <h2 class="text-xl font-bold tracking-[-0.03em]"><%= locatie.naam %></h2>
              </div>
              <span class="badge status-default"><%= locatie.type || '—' %></span>
            </div>

            <div class="space-y-3">
              <div class="info-item">
                <p class="eyebrow mb-2">Adres</p>
                <p class="font-semibold"><%= formatAddress(locatie) %></p>
              </div>
              <div class="info-item">
                <p class="eyebrow mb-2">Type locatie</p>
                <p class="font-semibold"><%= locatie.type || '—' %></p>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
              <a href="/locaties/<%= locatie.locatieid %>" class="btn btn-secondary">Bekijk</a>
              <a href="/locaties/<%= locatie.locatieid %>/edit" class="btn btn-secondary">Bewerk</a>
              <form action="/locaties/<%= locatie.locatieid %>" method="POST" onsubmit="return confirm('Weet je zeker dat je deze locatie wilt verwijderen?');">
                <input type="hidden" name="_method" value="DELETE" />
                <button type="submit" class="btn btn-danger">Verwijder</button>
              </form>
            </div>
          </article>
        <% }) %>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
