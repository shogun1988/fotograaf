<%- include('../partials/head', { title: title }) %>
<div class="app-shell flex min-h-screen bg-soft">
  <%- include('../partials/sidebar', { currentPath: currentPath }) %>
  <div class="min-w-0 flex-1">
    <header class="border-b border-line bg-white/80 px-6 py-5 backdrop-blur lg:px-8">
      <p class="eyebrow mb-2">Locatiebeheer</p>
      <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink"><%= pageTitle %></h1>
      <p class="muted mt-2 text-sm"><%= pageSubtitle %></p>
    </header>
    <main class="px-6 py-6 lg:px-8">
      <%- include('../partials/flash', { feedback: feedback }) %>
      <section class="surface-card p-6">
        <form action="/locaties" method="POST" class="space-y-8">
          <div>
            <h2 class="text-lg font-bold tracking-[-0.02em]">Locatiegegevens</h2>
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Naam</span>
                <input type="text" name="naam" required class="form-control" value="<%= locatie.naam %>" placeholder="bijv. Studio Gent" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Type</span>
                <select name="type" class="form-select">
                  <option value="studio"  <%= locatie.type === 'studio'  ? 'selected' : '' %>>Studio</option>
                  <option value="buiten"  <%= locatie.type === 'buiten'  ? 'selected' : '' %>>Buiten</option>
                  <option value="binnen"  <%= locatie.type === 'binnen'  ? 'selected' : '' %>>Binnen</option>
                  <option value="bedrijf" <%= locatie.type === 'bedrijf' ? 'selected' : '' %>>Bedrijf</option>
                </select>
              </label>
            </div>
          </div>

          <div>
            <h2 class="text-lg font-bold tracking-[-0.02em]">Adres</h2>
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              <label class="block md:col-span-2">
                <span class="mb-2 block text-sm font-semibold text-ink">Straat</span>
                <input type="text" name="straat" required class="form-control" value="<%= locatie.straat %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Huisnummer</span>
                <input type="text" name="huisnummer" required class="form-control" value="<%= locatie.huisnummer %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Busnummer</span>
                <input type="text" name="busnummer" class="form-control" value="<%= locatie.busnummer || '' %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Postcode</span>
                <input type="text" name="postcode" required class="form-control" value="<%= locatie.postcode %>" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-ink">Stad</span>
                <input type="text" name="stad" required class="form-control" value="<%= locatie.stad %>" />
              </label>
              <label class="block md:col-span-2">
                <span class="mb-2 block text-sm font-semibold text-ink">Land</span>
                <input type="text" name="land" class="form-control" value="<%= locatie.land %>" />
              </label>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <button type="submit" class="btn btn-primary">Locatie opslaan</button>
            <a href="/locaties" class="btn btn-secondary">Annuleren</a>
          </div>
        </form>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
