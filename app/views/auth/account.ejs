<%- include('../partials/head', { title: title }) %>
<div class="app-shell flex min-h-screen bg-soft">
  <%- include('../partials/sidebar', { currentPath: '/auth/account' }) %>

  <div class="min-w-0 flex-1">
    <header class="border-b border-line bg-white/80 px-6 py-5 backdrop-blur lg:px-8">
      <p class="eyebrow mb-2">Beveiliging</p>
      <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink">Mijn account</h1>
      <p class="muted mt-2 text-sm">Beheer je login en wijzig je wachtwoord veilig.</p>
    </header>

    <main class="px-6 py-6 lg:px-8">
      <section class="surface-card max-w-2xl p-6">
        <div class="flex items-center gap-3">
          <span class="auth-logo"><i data-lucide="lock-keyhole" class="h-5 w-5"></i></span>
          <div>
            <h2 class="text-lg font-bold">Wachtwoord wijzigen</h2>
            <p class="muted text-sm">Gebruikersnaam: <strong><%= username %></strong></p>
          </div>
        </div>

        <% if (error) { %>
          <div class="auth-error mt-6" role="alert"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="auth-success mt-6" role="status"><%= success %></div>
        <% } %>

        <form action="/auth/account/password" method="post" class="mt-6 space-y-4">
          <label class="form-label" for="currentPassword">Huidig wachtwoord</label>
          <input class="form-control" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required />
          <label class="form-label" for="newPassword">Nieuw wachtwoord</label>
          <input class="form-control" id="newPassword" name="newPassword" type="password" minlength="8" autocomplete="new-password" required />
          <label class="form-label" for="confirmPassword">Nieuw wachtwoord bevestigen</label>
          <input class="form-control" id="confirmPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required />
          <button class="btn btn-primary" type="submit">
            <i data-lucide="key-round" class="h-4 w-4"></i>
            Wachtwoord wijzigen
          </button>
        </form>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
