<%- include('../partials/head', { title: title }) %>
<div class="app-shell flex min-h-screen bg-soft">
  <%- include('../partials/sidebar', { currentPath: currentPath }) %>
  <div class="min-w-0 flex-1">
    <header class="border-b border-line bg-white/80 px-6 py-5 backdrop-blur lg:px-8">
      <p class="eyebrow mb-2">Facturatie</p>
      <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink"><%= pageTitle %></h1>
      <p class="muted mt-2 text-sm"><%= pageSubtitle %></p>
    </header>
    <main class="px-6 py-6 lg:px-8">
      <%- include('../partials/flash', { feedback: feedback }) %>
      <section class="surface-card p-6">
        <form action="/facturen/<%= factuur.factuurid %>" method="POST" class="space-y-6">
          <input type="hidden" name="_method" value="PUT" />
          <div class="grid gap-4 md:grid-cols-2">
            <label class="block">
              <span class="mb-2 block text-sm font-semibold text-ink">Klant</span>
              <select name="klant_id" required class="form-select">
                <option value="">— Kies klant —</option>
                <% klanten.forEach(k => { %>
                  <option value="<%= k.klantid %>" <%= factuur.klant_id == k.klantid ? 'selected' : '' %>><%= k.voornaam %> <%= k.achternaam %></option>
                <% }) %>
              </select>
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-semibold text-ink">Fotoshoot (optioneel)</span>
              <select name="fotoshoot_id" class="form-select">
                <option value="">— Geen —</option>
                <% fotoshoots.forEach(f => { %>
                  <option value="<%= f.fotoshootid %>" <%= factuur.fotoshoot_id == f.fotoshootid ? 'selected' : '' %>>#<%= f.fotoshootid %> — <%= f.klant_naam %> (<%= f.datum ? f.datum.slice(0,10) : '—' %>)</option>
                <% }) %>
              </select>
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-semibold text-ink">Datum</span>
              <input type="date" name="datum" required class="form-control" value="<%= factuur.datum ? String(factuur.datum).slice(0,10) : '' %>" />
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-semibold text-ink">Totaalbedrag (€)</span>
              <input type="number" name="totaalbedrag" required step="0.01" min="0" class="form-control" value="<%= factuur.totaalbedrag %>" />
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-semibold text-ink">Status</span>
              <select name="status" class="form-select">
                <option value="open"    <%= factuur.status === 'open'    ? 'selected' : '' %>>Open</option>
                <option value="betaald" <%= factuur.status === 'betaald' ? 'selected' : '' %>>Betaald</option>
              </select>
            </label>
          </div>
          <div class="flex flex-wrap gap-3">
            <button type="submit" class="btn btn-primary">Wijzigingen opslaan</button>
            <a href="/facturen" class="btn btn-secondary">Annuleren</a>
          </div>
        </form>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
